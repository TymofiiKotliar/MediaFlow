<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="MediaFlow"
           Manufacturer="MediaFlow"
           Version="1.0.1"
           UpgradeCode="241DC449-12BD-4390-8CCB-E9AA42FD922D"
           Language="1033"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of MediaFlow is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MediaFlow" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SHORTCUTDIR" Name="MediaFlow" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)*.exe" />
    </ComponentGroup>

    <Component Id="ApplicationShortcut" Directory="SHORTCUTDIR" Guid="C3B880DC-C67B-4B63-92E3-E36A95120ED9">
      <Shortcut Id="AppStartMenuShortcut"
                Name="MediaFlow"
                Target="[INSTALLFOLDER]MediaFlow.Presentation.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="CleanUpShortcutFolder" Directory="SHORTCUTDIR" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\MediaFlow" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Icon Id="AppIcon" SourceFile="..\src\MediaFlow.Presentation\Assets\App-Icons\AppIconWindows.ico" />

    <!-- Repoints WixUI_InstallDir's folder-browse dialog at the shortcut
         directory (SHORTCUTDIR) instead of the app install directory, so the
         user can pick where the Start Menu shortcut is created. -->
    <Property Id="WIXUI_INSTALLDIR" Value="SHORTCUTDIR" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
